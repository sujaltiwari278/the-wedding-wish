# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wedding_wish?retryWrites=true&w=majority

# NextAuth / Auth.js Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=super_secret_pixel_wedding_key_change_me
NEXTAUTH_URL=http://localhost:3000

# Base App URL for sharing links & QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Test Keys (For Phase 2)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Google Gemini API Key (Server-Side AI Features)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

